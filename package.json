{
  "name": "@hamdevco/analytics",
  "version": "0.6.0",
  "description": "Shared PostHog instrumentation for the HamDevCo / BerryBloom site fleet.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./schema": "./src/schema.js",
    "./middleware": {
      "types": "./src/middleware.d.ts",
      "default": "./src/middleware.js"
    },
    "./nginx/ingest.conf": "./nginx/ingest.conf",
    "./route": {
      "types": "./src/route.d.ts",
      "default": "./src/route.js"
    },
    "./content": {
      "types": "./src/content.d.ts",
      "default": "./src/content.js"
    },
    "./content-schema": "./src/content-schema.js"
  },
  "files": [
    "src",
    "nginx",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "peerDependencies": {
    "posthog-js": ">=1.100.0"
  },
  "license": "UNLICENSED",
  "private": true,
  "types": "./src/index.d.ts"
}
